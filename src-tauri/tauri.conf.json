{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hidden Audio Converter",
  "version": "1.0.0",
  "identifier": "com.rizkivalency.hiddenaudio",
  "build": {
    "frontendDist": "../src-tauri/dist",
    "beforeDevCommand": "python scripts/sync_dist.py",
    "beforeBuildCommand": "python scripts/sync_dist.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hidden Audio Batch Converter",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Batch audio -> OGG hidden-speed converter",
    "macOS": {
      "signingIdentity": "-"
    },
    "externalBin": ["binaries/hidden-audio-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
