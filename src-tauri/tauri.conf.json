{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valency Studio",
  "version": "1.1.1",
  "identifier": "com.rizkivalency.hiddenaudio",
  "build": {
    "frontendDist": "../src-tauri/dist",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "python scripts/sync_dist.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Valency Studio | Audio Converter",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyQkJFQ0NEODVGMUY4NwpSV1NISDEvWXpMNHJCODNON3BpTjc5VjgxOWNIOGtqOFg0S3cxN01XSkR6TzRzODl3Mlo1T29Bcwo=",
      "endpoints": [
        "https://github.com/rizkikotet-dev/myapps/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "Batch audio -> OGG converter dengan trik sample-rate untuk Roblox Studio",
    "macOS": {
      "signingIdentity": "-"
    },
    "externalBin": ["binaries/valency-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
